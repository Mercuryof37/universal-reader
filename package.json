{
  "name": "universal-reader",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "通用文档阅读器 · 纯前端离线优先的双语对照阅读器",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "predev": "node scripts/copy-pdfjs-wasm.mjs && node scripts/make-icons.mjs && node scripts/fetch-ocr-models.mjs && node scripts/fetch-tess-assets.mjs",
    "prebuild": "node scripts/copy-pdfjs-wasm.mjs && node scripts/make-icons.mjs && node scripts/fetch-ocr-models.mjs && node scripts/fetch-tess-assets.mjs",
    "postbuild": "node scripts/clean-onnx-wasm.mjs && node scripts/verify-dist.mjs",
    "copy-wasm": "node scripts/copy-pdfjs-wasm.mjs",
    "fetch-ocr-models": "node scripts/fetch-ocr-models.mjs",
    "fetch-tess-assets": "node scripts/fetch-tess-assets.mjs",
    "icons": "node scripts/make-icons.mjs",
    "verify-dist": "node scripts/verify-dist.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "dexie": "^4.4.6",
    "epubjs": "^0.3.93",
    "katex": "^0.19.0",
    "lucide-react": "^0.548.0",
    "onnxruntime-web": "^1.30.0",
    "pdfjs-dist": "^5.7.284",
    "ppu-paddle-ocr": "^6.6.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "tesseract.js": "^7.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  }
}
